# ---- Telemetry is OFF unless you opt in. Copy this file to .env to try the POC. ----
# Master switch (default: false = nothing loaded, patched, stored or sent)
VITE_OTEL_ENABLED=true
# true = also wait for the user to click "Allow telemetry" (remembered in localStorage)
VITE_OTEL_REQUIRE_CONSENT=false

# Which signals to send (default: all three). Comma list of: traces,metrics,logs
# VITE_OTEL_SIGNALS=traces,logs
# Which automatic features to turn on (default: all). Comma list of:
#   documentLoad,userInteraction,fetch,xhr,webVitals,errors,consoleCapture
# VITE_OTEL_FEATURES=fetch,xhr,errors

# Collector base URL; the app appends /v1/traces, /v1/metrics and /v1/logs
VITE_OTLP_BASE_URL=http://localhost:4318
# 1 = keep 100% (POC); e.g. 0.1 in prod
VITE_SAMPLE_RATIO=1
VITE_ENV=local
# Origins that receive the `traceparent` header (comma list, substring match)
VITE_OTEL_PROPAGATE_TO=localhost:3000
# Extra URLs never to trace (the collector URL is always ignored)
# VITE_OTEL_IGNORE_URLS=
VITE_OTEL_METRICS_INTERVAL_MS=10000
# Print spans/logs in the browser console (default: false)
VITE_CONSOLE_SPANS=true
